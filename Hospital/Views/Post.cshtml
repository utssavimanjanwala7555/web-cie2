@model List<HospitalAppointmentManagement.Models.Post>

@{
    ViewData["Title"] = "Posts";
}

<h2>Posts from JSONPlaceholder</h2>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Post ID</th>
            <th>Title</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var post in Model)
        {
            <tr>
                <td>@post.Id</td>
                <td>@post.Title</td>
            </tr>
        }
    </tbody>
</table>
